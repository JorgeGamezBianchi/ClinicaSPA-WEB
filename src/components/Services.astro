---
import { services } from "../data/services";
import { siteConfig } from "../data/siteConfig";

const categories = [
  { key: "todos", label: "Todos los Tratamientos" },
  { key: "faciales", label: "Faciales Médicos" },
  { key: "aparatologia", label: "Aparatología Avanzada" },
  { key: "corporales", label: "Corporales & Masajes" },
  { key: "medicina-estetica", label: "Medicina Estética" },
];
---

<section class="section-padding services-section" id="servicios">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Carta de Tratamientos</span>
      <h2 class="section-title">Protocolos Clínicos Diseñados a tu Medida</h2>
      <p class="section-subtitle">
        Combinamos diagnóstico especializado, aparatología de última generación y activos dermatológicos para cuidar y embellecer tu piel con máxima seguridad.
      </p>

      <!-- BOTONES DE FILTRO -->
      <div class="services-filter-tabs" id="services-tabs">
        {
          categories.map((cat, index) => (
            <button
              class={`filter-tab ${index === 0 ? "active" : ""}`}
              data-filter={cat.key}
            >
              {cat.label}
            </button>
          ))
        }
      </div>
    </div>

    <!-- GRID DE SERVICIOS -->
    <div class="services-grid" id="services-container">
      {
        services.map((service) => {
          const serviceWhatsAppMsg = `¡Hola! Me interesa solicitar información y agendar una cita para el tratamiento: ${service.name}.`;
          const serviceWhatsAppUrl = `https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(serviceWhatsAppMsg)}`;

          return (
            <div class="service-card card" data-category={service.category}>
              <div class="service-media">
                <img
                  src={service.image}
                  alt={service.name}
                  class="service-img"
                  loading="lazy"
                />
                {service.badge && (
                  <span class="service-badge badge-pill">{service.badge}</span>
                )}
                <span class="service-category-tag">{service.categoryLabel}</span>
              </div>

              <div class="service-body">
                <div class="service-meta">
                  <span class="service-price">{service.price}</span>
                  <span class="service-duration">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10" />
                      <path d="M12 6v6l4 2" />
                    </svg>
                    {service.duration}
                  </span>
                </div>

                <h3 class="service-name">{service.name}</h3>
                <p class="service-tagline">{service.tagline}</p>
                <p class="service-desc">{service.description}</p>

                <!-- Beneficios -->
                <div class="service-benefits">
                  <span class="benefits-title">Beneficios clave:</span>
                  <ul>
                    {service.benefits.map((benefit) => (
                      <li>
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                          <polyline points="20 6 9 17 4 12" />
                        </svg>
                        <span>{benefit}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="service-ideal">
                  <strong>Recomendado para:</strong> {service.recommendedFor}
                </div>

                <div class="service-footer">
                  <a
                    href={serviceWhatsAppUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary btn-sm service-cta"
                  >
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                    </svg>
                    Agendar este Tratamiento
                  </a>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .services-section {
    background: var(--color-bg-base);
  }

  /* Filtros */
  .services-filter-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }
  .filter-tab {
    padding: 10px 20px;
    border-radius: var(--radius-pill);
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-body);
    transition: var(--transition);
  }
  .filter-tab:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .filter-tab.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(141, 91, 76, 0.25);
  }

  /* Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 32px;
  }

  /* Tarjeta de Servicio */
  .service-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-card);
    transition: var(--transition);
  }
  .service-card.hidden {
    display: none;
  }

  .service-media {
    position: relative;
    height: 220px;
    overflow: hidden;
  }
  .service-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .service-card:hover .service-img {
    transform: scale(1.05);
  }

  .service-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
  }
  .service-category-tag {
    position: absolute;
    bottom: 14px;
    right: 14px;
    background: rgba(31, 36, 33, 0.85);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }

  /* Cuerpo */
  .service-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .service-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .service-price {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-primary);
  }
  .service-duration {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .service-name {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--color-text-dark);
    line-height: 1.25;
    margin-bottom: 6px;
  }
  .service-tagline {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-sage-dark);
    margin-bottom: 12px;
  }
  .service-desc {
    font-size: 0.92rem;
    color: var(--color-text-body);
    line-height: 1.55;
    margin-bottom: 18px;
  }

  /* Beneficios */
  .service-benefits {
    background: var(--color-bg-base);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    margin-bottom: 16px;
  }
  .benefits-title {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--color-text-dark);
    margin-bottom: 8px;
  }
  .service-benefits ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .service-benefits li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.84rem;
    color: var(--color-text-body);
  }
  .service-benefits li svg {
    color: var(--color-sage);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .service-ideal {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-bottom: 20px;
    border-left: 2px solid var(--color-gold);
    padding-left: 10px;
  }
  .service-ideal strong {
    color: var(--color-text-dark);
  }

  /* Footer */
  .service-footer {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
  }
  .service-cta {
    width: 100%;
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .services-filter-tabs {
      gap: 8px;
      margin-top: 20px;
    }
    .filter-tab {
      padding: 8px 14px;
      font-size: 0.82rem;
    }
  }

  @media (max-width: 480px) {
    .service-body {
      padding: 20px 16px;
    }
    .service-media {
      height: 200px;
    }
  }
</style>

<script>
  // Script para filtrado reactivo de categorías
  const filterTabs = document.querySelectorAll(".filter-tab");
  const serviceCards = document.querySelectorAll(".service-card");

  filterTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      // Quitar clase activa previa
      filterTabs.forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");

      const filter = tab.getAttribute("data-filter");

      serviceCards.forEach((card) => {
        const category = card.getAttribute("data-category");
        if (filter === "todos" || category === filter) {
          card.classList.remove("hidden");
        } else {
          card.classList.add("hidden");
        }
      });
    });
  });
</script>
