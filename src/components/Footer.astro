---
import { siteConfig } from "../data/siteConfig";
---

<footer class="site-footer">
  <div class="container footer-top">
    <!-- Columna 1: Marca y Filosofía -->
    <div class="footer-col brand-col">
      <div class="footer-logo">
        <div class="logo-icon-wrap">
          <svg class="logo-svg" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="24" cy="24" r="23" stroke="#ffffff" stroke-width="1.5" stroke-dasharray="2 3" opacity="0.3" />
            <path d="M24 8 C20 18 16 26 16 33 C16 39.5 19.5 42 24 42 C28.5 42 32 39.5 32 33 C32 26 28 18 24 8 Z" fill="#ffffff" />
            <path d="M22 20 C16 23 10 29 10 35 C10 39 13 41 17 41 C21 41 23 37 23 33 Z" fill="#dfba4d" opacity="0.9" />
            <path d="M26 20 C32 23 38 29 38 35 C38 39 35 41 31 41 C27 41 25 37 25 33 Z" fill="#dfba4d" opacity="0.9" />
          </svg>
        </div>
        <div class="logo-brand">
          <span class="logo-name">{siteConfig.shortName}</span>
          <span class="logo-type">CLÍNICA & BIENESTAR</span>
        </div>
      </div>

      <p class="footer-about">
        Centro especializado en medicina estética, aparatología original de última generación y spa clínico. Cuidamos de tu salud dérmica y bienestar integral.
      </p>

      <div class="footer-socials">
        <!-- Facebook oficial -->
        <a href={siteConfig.social.facebook} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Facebook Oficial">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
          </svg>
        </a>

        <!-- Instagram -->
        <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
          </svg>
        </a>

        <!-- WhatsApp -->
        <a href={`https://wa.me/${siteConfig.whatsapp}`} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Columna 2: Navegación -->
    <div class="footer-col">
      <h4 class="footer-title">Navegación</h4>
      <ul class="footer-links">
        <li><a href="#inicio">Inicio</a></li>
        <li><a href="#servicios">Carta de Servicios</a></li>
        <li><a href="#tecnologia">Aparatología Médica</a></li>
        <li><a href="#paquetes">Paquetes & Membresías</a></li>
        <li><a href="#productos">Productos</a></li>
        <li><a href="#nosotros">Nuestra Clínica</a></li>
        <li><a href="#preguntas">Preguntas Frecuentes</a></li>
        <li><a href="#contacto">Contacto & Citas</a></li>
      </ul>
    </div>

    <!-- Columna 3: Tratamientos Destacados -->
    <div class="footer-col">
      <h4 class="footer-title">Tratamientos</h4>
      <ul class="footer-links">
        <li><a href="#servicios">Scarlet S Microneedling</a></li>
        <li><a href="#servicios">Hidrofacial Clínico</a></li>
        <li><a href="#servicios">V10 de Viora Corporal</a></li>
        <li><a href="#servicios">Depilación Láser Diodo</a></li>
        <li><a href="#servicios">Coolifting Facial Express</a></li>
        <li><a href="#servicios">Masaje Relajante & Drenaje</a></li>
        <li><a href="#servicios">Toxina Botulínica y Rellenos</a></li>
      </ul>
    </div>

    <!-- Columna 4: Contacto Rápido -->
    <div class="footer-col">
      <h4 class="footer-title">Contacto</h4>
      <div class="footer-contact-info">
        <p><strong>Dirección:</strong><br />{siteConfig.address.street}, {siteConfig.address.city}, {siteConfig.address.state}</p>
        <p><strong>Teléfono:</strong><br /><a href={`tel:${siteConfig.phone}`}>{siteConfig.phoneDisplay}</a></p>
        <p><strong>WhatsApp Citas:</strong><br /><a href={`https://wa.me/${siteConfig.whatsapp}`} target="_blank" rel="noopener">{siteConfig.whatsappDisplay}</a></p>
        <p><strong>Horario:</strong><br />{siteConfig.schedule.weekdays}<br />{siteConfig.schedule.saturday}</p>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <p class="copyright">
        © {new Date().getFullYear()} {siteConfig.name}. Todos los derechos reservados.
      </p>
      <div class="footer-bottom-links">
        <a href="#inicio">Aviso de Privacidad</a>
        <span class="footer-dot">•</span>
        <a href="#inicio">Términos del Servicio</a>
        <span class="footer-dot">•</span>
        <span class="template-tag">Plantilla Profesional creada por Jorge Gámez</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #141816;
    color: #e2e8e5;
    padding-top: 80px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 48px;
    padding-bottom: 60px;
  }

  /* Logo */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .logo-icon-wrap {
    width: 42px;
    height: 42px;
  }
  .logo-svg {
    width: 100%;
    height: 100%;
  }
  .logo-brand {
    display: flex;
    flex-direction: column;
  }
  .logo-name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1;
    letter-spacing: 1.5px;
  }
  .logo-type {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--color-gold-light);
    margin-top: 2px;
  }

  .footer-about {
    font-size: 0.9rem;
    color: #9ba8a0;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .footer-socials {
    display: flex;
    gap: 12px;
  }
  .social-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
  }
  .social-icon:hover {
    background: var(--color-primary);
    transform: translateY(-3px);
  }

  /* Columnas */
  .footer-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 20px;
    position: relative;
    padding-bottom: 8px;
  }
  .footer-title::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 28px;
    height: 2px;
    background: var(--color-gold);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .footer-links a {
    font-size: 0.9rem;
    color: #9ba8a0;
    transition: var(--transition);
  }
  .footer-links a:hover {
    color: #ffffff;
    padding-left: 4px;
  }

  .footer-contact-info {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 0.88rem;
    color: #9ba8a0;
    line-height: 1.5;
  }
  .footer-contact-info strong {
    color: #ffffff;
  }
  .footer-contact-info a {
    color: var(--color-gold-light);
  }
  .footer-contact-info a:hover {
    text-decoration: underline;
  }

  /* Bottom */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 24px 0 32px 0;
    font-size: 0.82rem;
    color: #75837b;
  }
  .footer-bottom-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .footer-bottom-links a:hover {
    color: #ffffff;
  }
  .template-tag {
    color: var(--color-gold-light);
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .footer-top {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      padding-top: 56px;
    }
    .footer-top {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-bottom: 40px;
    }
    .footer-bottom-container {
      flex-direction: column;
      text-align: center;
      gap: 12px;
    }
    .footer-bottom-links {
      flex-direction: column;
      gap: 8px;
    }
    .footer-bottom-links .footer-dot {
      display: none;
    }
  }
</style>
