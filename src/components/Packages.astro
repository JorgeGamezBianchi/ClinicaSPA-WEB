---
import { packages } from "../data/packages";
import { siteConfig } from "../data/siteConfig";
---

<section class="section-padding packages-section" id="paquetes">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Paquetes & Membresías</span>
      <h2 class="section-title">Experiencias Integrales con Precios Especiales</h2>
      <p class="section-subtitle">
        Diseñamos planes integrales que potencian los resultados de cada sesión, ofreciéndote un ahorro significativo frente a la contratación individual.
      </p>
    </div>

    <div class="packages-grid">
      {
        packages.map((pkg) => {
          const pkgWhatsAppMsg = `¡Hola! Me gustaría aprovechar la promoción del "${pkg.name}" (${pkg.price}) y conocer disponibilidad de agenda.`;
          const pkgWhatsAppUrl = `https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(pkgWhatsAppMsg)}`;

          return (
            <div class={`package-card card ${pkg.popular ? "popular-card" : ""}`}>
              {pkg.badge && (
                <div class="pkg-top-badge">
                  <span>{pkg.badge}</span>
                </div>
              )}

              <div class="package-header">
                <h3 class="package-title">{pkg.name}</h3>
                <p class="package-tagline">{pkg.tagline}</p>

                <div class="package-price-wrap">
                  <span class="package-price">{pkg.price}</span>
                  {pkg.originalPrice && (
                    <span class="package-original-price">{pkg.originalPrice}</span>
                  )}
                </div>

                {pkg.savings && (
                  <span class="package-savings-badge">{pkg.savings}</span>
                )}

                <div class="package-duration">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                  </svg>
                  <span>Duración: {pkg.duration}</span>
                </div>
              </div>

              <div class="package-body">
                <p class="package-desc">{pkg.description}</p>

                <div class="package-includes">
                  <span class="includes-label">Este paquete incluye:</span>
                  <ul>
                    {pkg.includes.map((item) => (
                      <li>
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                          <polyline points="20 6 9 17 4 12" />
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="package-footer">
                <a
                  href={pkgWhatsAppUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`btn ${pkg.popular ? "btn-primary" : "btn-secondary"} package-btn`}
                >
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                  </svg>
                  Reservar este Paquete
                </a>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .packages-section {
    background: var(--color-bg-base);
  }

  .packages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 32px;
  }

  .package-card {
    position: relative;
    padding: 36px 28px;
    background: var(--color-bg-white);
    display: flex;
    flex-direction: column;
    border: 1.5px solid var(--color-border);
  }

  .package-card.popular-card {
    border-color: var(--color-gold);
    box-shadow: 0 12px 32px rgba(197, 155, 39, 0.16);
    transform: translateY(-4px);
  }

  .pkg-top-badge {
    position: absolute;
    top: -12px;
    right: 24px;
    background: linear-gradient(135deg, var(--color-gold), var(--color-gold-light));
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 4px 14px;
    border-radius: var(--radius-pill);
    box-shadow: 0 2px 8px rgba(197, 155, 39, 0.4);
  }

  .package-title {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    font-weight: 600;
    color: var(--color-text-dark);
    margin-bottom: 6px;
  }

  .package-tagline {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 18px;
  }

  .package-price-wrap {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 6px;
  }

  .package-price {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .package-original-price {
    font-size: 1rem;
    color: var(--color-text-light);
    text-decoration: line-through;
  }

  .package-savings-badge {
    display: inline-block;
    font-size: 0.76rem;
    font-weight: 700;
    color: #276749;
    background: #e6fffa;
    border: 1px solid #b2f5ea;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    margin-bottom: 14px;
  }

  .package-duration {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    color: var(--color-sage-dark);
    font-weight: 600;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--color-border);
  }

  .package-body {
    padding: 18px 0;
    flex-grow: 1;
  }

  .package-desc {
    font-size: 0.9rem;
    color: var(--color-text-body);
    line-height: 1.5;
    margin-bottom: 20px;
  }

  .includes-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-dark);
    margin-bottom: 12px;
  }

  .package-includes ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .package-includes li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.86rem;
    color: var(--color-text-body);
  }

  .package-includes li svg {
    color: var(--color-sage);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .package-footer {
    padding-top: 18px;
  }

  .package-btn {
    width: 100%;
  }

  @media (max-width: 768px) {
    .packages-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 480px) {
    .package-card {
      padding: 26px 18px;
    }
    .package-price {
      font-size: 1.9rem;
    }
    .package-title {
      font-size: 1.45rem;
    }
  }
</style>
