---
import { siteConfig } from "../data/siteConfig";

const whatsappLink = `https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(siteConfig.whatsappDefaultMessage)}`;
---

<section class="hero-section" id="inicio">
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>Clínica Dermatológica & Spa de Alta Gama</span>
      </div>

      <h1 class="hero-title">
        La armonía perfecta entre <br />
        <span class="hero-title-accent">ciencia estética</span> y bienestar
      </h1>

      <p class="hero-desc">
        Descubre un espacio exclusivo diseñado para tu salud cutánea y relajación profunda. Tratamientos faciales avanzados, aparatología médica certificada, depilación láser y masajes terapéuticos guiados por especialistas.
      </p>

      <div class="hero-actions">
        <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp hero-btn">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          Agendar Cita por WhatsApp
        </a>

        <a href="#servicios" class="btn btn-secondary hero-btn">
          Ver Catálogo de Servicios
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Puntos de Confianza Rápidos -->
      <div class="hero-trust">
        <div class="trust-item">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            <path d="M9 12l2 2 4-4" />
          </svg>
          <span>Aparatología Médica Original</span>
        </div>
        <div class="trust-item">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
          <span>Especialistas Certificados</span>
        </div>
        <div class="trust-item">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 6v6l4 2" />
          </svg>
          <span>Cabinas Privadas Climatizadas</span>
        </div>
      </div>
    </div>

    <!-- IMAGEN Y ELEMENTOS VISUALES DEL HERO -->
    <div class="hero-media">
      <div class="hero-image-wrapper">
        <img
          src="https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=1000&q=85"
          alt="Tratamiento de spa y bienestar facial"
          class="hero-img"
          loading="eager"
        />
        <div class="hero-glow"></div>

        <!-- Tarjeta Flotante 1: Tratamiento Estrella -->
        <div class="hero-float-card card-star">
          <div class="float-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </svg>
          </div>
          <div>
            <strong>Scarlet S Radiofrecuencia</strong>
            <span>Efecto tensor dérmico sin cirugía</span>
          </div>
        </div>

        <!-- Tarjeta Flotante 2: Calificación Real -->
        <div class="hero-float-card card-rating">
          <div class="stars-row">
            ★★★★★
          </div>
          <strong>4.9 / 5.0 en Google & Facebook</strong>
          <span>+500 valoraciones reales</span>
        </div>
      </div>
    </div>
  </div>

  <!-- BARRA DE ESTADÍSTICAS -->
  <div class="hero-stats-bar">
    <div class="container stats-container">
      {
        siteConfig.stats.map((stat) => (
          <div class="stat-box">
            <span class="stat-number">{stat.number}</span>
            <div class="stat-text">
              <span class="stat-title">{stat.label}</span>
              {stat.sublabel && <span class="stat-sub">{stat.sublabel}</span>}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: 56px;
    padding-bottom: 40px;
    background: radial-gradient(circle at 10% 20%, rgba(246, 241, 232, 0.7) 0%, rgba(253, 251, 247, 1) 90%);
    overflow: hidden;
  }
  .hero-container {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    min-height: 580px;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary-dark);
    box-shadow: var(--shadow-sm);
    margin-bottom: 24px;
  }
  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--color-gold);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-gold);
  }

  /* Textos */
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5.5vw, 4.2rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-text-dark);
    margin-bottom: 24px;
    overflow-wrap: break-word;
  }
  .hero-title-accent {
    color: var(--color-primary);
    font-style: italic;
  }
  .hero-desc {
    font-size: clamp(0.98rem, 2vw, 1.12rem);
    color: var(--color-text-body);
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 580px;
  }

  /* Acciones */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 40px;
  }
  .hero-btn {
    padding: 16px 32px;
    font-size: 1rem;
  }

  /* Trust */
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }
  .trust-item svg {
    color: var(--color-sage);
    flex-shrink: 0;
  }

  /* Media */
  .hero-media {
    position: relative;
    width: 100%;
  }
  .hero-image-wrapper {
    position: relative;
    border-radius: var(--radius-xl);
    padding: 12px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(246, 241, 232, 0.5));
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-xl);
  }
  .hero-img {
    width: 100%;
    height: clamp(280px, 45vw, 520px);
    object-fit: cover;
    border-radius: 24px;
  }
  .hero-glow {
    position: absolute;
    top: -20px;
    right: -20px;
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(197, 155, 39, 0.15) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Tarjetas Flotantes */
  .hero-float-card {
    position: absolute;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: var(--shadow-lg);
    border-radius: var(--radius-md);
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 2;
  }
  .card-star {
    top: 30px;
    left: -20px;
  }
  .card-star .float-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-gold-bg);
    color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-star strong {
    display: block;
    font-size: 0.88rem;
    color: var(--color-text-dark);
  }
  .card-star span {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .card-rating {
    bottom: 30px;
    right: -15px;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }
  .stars-row {
    color: #e6a817;
    font-size: 0.9rem;
    letter-spacing: 2px;
  }
  .card-rating strong {
    font-size: 0.85rem;
    color: var(--color-text-dark);
  }
  .card-rating span {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  /* Stats Bar */
  .hero-stats-bar {
    margin-top: 72px;
    background: var(--color-bg-white);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 32px 0;
  }
  .stats-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .stat-box {
    display: flex;
    align-items: center;
    gap: 16px;
    border-right: 1px solid var(--color-border);
  }
  .stat-box:last-child {
    border-right: none;
  }
  .stat-number {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
  }
  .stat-text {
    display: flex;
    flex-direction: column;
  }
  .stat-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-dark);
  }
  .stat-sub {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 48px;
      min-height: auto;
    }
    .hero-media {
      max-width: 650px;
      margin: 0 auto;
    }
    .card-star {
      left: 10px;
    }
    .card-rating {
      right: 10px;
    }
    .stats-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .stat-box:nth-child(2) {
      border-right: none;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding-top: 36px;
    }
    .stats-container {
      grid-template-columns: 1fr;
    }
    .stat-box {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      padding-bottom: 16px;
    }
    .stat-box:last-child {
      border-bottom: none;
    }
    .hero-img {
      height: clamp(260px, 70vw, 360px);
    }
    .card-star,
    .card-rating {
      position: static;
      margin-top: 12px;
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .hero-actions {
      flex-direction: column;
      gap: 12px;
    }
    .hero-btn {
      width: 100%;
      padding: 14px 20px;
    }
    .hero-trust {
      flex-direction: column;
      gap: 12px;
    }
    .hero-badge {
      font-size: 0.78rem;
      padding: 6px 14px;
      margin-bottom: 18px;
    }
    .stat-number {
      font-size: 2.4rem;
    }
  }
</style>
