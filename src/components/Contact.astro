<script>
  // Enviar formulario redirigiendo a WhatsApp con todos los campos organizados
  const bookingForm = document.getElementById("booking-form") as HTMLFormElement;
  const successBox = document.getElementById("form-success-box") as HTMLDivElement;
  const successText = document.getElementById("success-summary-text") as HTMLParagraphElement;
  const successWaBtn = document.getElementById("success-wa-btn") as HTMLAnchorElement;
  const resetBtn = document.getElementById("reset-form-btn") as HTMLButtonElement;
  const dateInput = document.getElementById("form-date") as HTMLInputElement;

  // Establecer fecha mínima en el selector como el día de hoy
  if (dateInput) {
    const today = new Date().toISOString().split("T")[0];
    dateInput.min = today;
  }

  if (bookingForm) {
    bookingForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const whatsapp = bookingForm.getAttribute("data-whatsapp") || "525500000000";
      const name = (document.getElementById("form-name") as HTMLInputElement).value.trim();
      const phone = (document.getElementById("form-phone") as HTMLInputElement).value.trim();
      const email = (document.getElementById("form-email") as HTMLInputElement).value.trim();
      const date = (document.getElementById("form-date") as HTMLInputElement).value;
      const treatment = (document.getElementById("form-treatment") as HTMLSelectElement).value;
      const schedule = (document.getElementById("form-schedule") as HTMLSelectElement).value;
      const message = (document.getElementById("form-message") as HTMLTextAreaElement).value.trim();

      // Construcción del mensaje formateado y profesional para WhatsApp
      let waText = `¡Hola Clínica Spa! Deseo solicitar una cita de valoración médica:\n\n` +
        `👤 *Nombre:* ${name}\n` +
        `📱 *Teléfono:* ${phone}\n`;

      if (email) {
        waText += `✉️ *Correo:* ${email}\n`;
      }

      waText += `✨ *Tratamiento de interés:* ${treatment}\n`;

      if (date) {
        waText += `📅 *Fecha sugerida:* ${date}\n`;
      }

      waText += `⏰ *Preferencia de horario:* ${schedule}\n`;

      if (message) {
        waText += `💬 *Comentarios/Dudas:* ${message}\n`;
      }

      waText += `\n¿Me podrían confirmar si tienen disponibilidad? Muchas gracias.`;

      const targetUrl = `https://wa.me/${whatsapp}?text=${encodeURIComponent(waText)}`;

      // Mostrar caja de éxito visual en el formulario
      if (successBox && successText && successWaBtn) {
        successText.innerHTML = `Listo <strong>${name}</strong>, tu solicitud para <em>${treatment}</em> ha sido preparada. Si no se abrió WhatsApp automáticamente, pulsa el botón verde:`;
        successWaBtn.href = targetUrl;
        successBox.style.display = "flex";
        successBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }

      // Abrir WhatsApp en pestaña nueva o app
      window.open(targetUrl, "_blank");
    });
  }

  if (resetBtn && bookingForm && successBox) {
    resetBtn.addEventListener("click", () => {
      successBox.style.display = "none";
      const nameInput = document.getElementById("form-name") as HTMLInputElement;
      if (nameInput) nameInput.focus();
    });
  }
</script>
